<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android TV support, one APK.

        `touchscreen required="false"` is the line that actually matters: a
        touchscreen is implicitly *required* unless declared otherwise, and Play
        filters the app off every television in the store on that basis alone.
        Nothing else here works without it.

        `leanback required="false"` says the app understands televisions but
        does not insist on one — required="true" would hide it from every phone.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:banner="@drawable/tv_banner"
        android:name=".SinemaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sinema">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <!--
                    A television launcher only lists activities carrying this
                    category; LAUNCHER alone is invisible there. Both sit in one
                    filter because it is the same entry point either way — the
                    app decides how to draw itself from the configuration, not
                    from which icon was tapped.
                -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>