<?xml version="1.0" encoding="utf-8"?>
<!--
  The splash mark, taken apart so every piece can move on its own.

  ic_launcher_foreground draws the film frame as a single evenOdd path: the
  body, the window and all six sprockets are one shape, and the holes exist
  only because the fill rule skips them. Nothing inside such a path can be
  animated separately, so here the body is solid and the window and sprockets
  are laid over it in the splash background colour — they read as holes and
  behave as objects.

  Geometry is unchanged. Same 108dp canvas, same coordinates, so this lands on
  the same pixels as the static mark API 26-30 gets.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Body: the rounded rect, now solid. -->
    <group android:name="frame" android:pivotX="54" android:pivotY="54">
        <path
            android:name="filmBody"
            android:fillColor="#FFB648"
            android:pathData="M35,36H73A7,7 0 0 1 80,43V65A7,7 0 0 1 73,72H35A7,7 0 0 1 28,65V43A7,7 0 0 1 35,36Z" />
    </group>

    <!-- The viewing window, opening like an aperture. -->
    <group android:name="window" android:pivotX="54" android:pivotY="54">
        <path
            android:name="windowPath"
            android:fillColor="@color/splash_background"
            android:pathData="M43,42A3,3 0 0 0 40,45V63A3,3 0 0 0 43,66H65A3,3 0 0 0 68,63V45A3,3 0 0 0 65,42Z" />
    </group>

    <!-- Six sprockets, each its own group so they can punch through in sequence. -->
    <group android:name="sprocketL1" android:pivotX="34" android:pivotY="42">
        <path android:name="sL1" android:fillColor="@color/splash_background"
            android:pathData="M33.05,40A1.3,1.3 0 0 0 31.75,41.3V42.7A1.3,1.3 0 0 0 33.05,44H34.95A1.3,1.3 0 0 0 36.25,42.7V41.3A1.3,1.3 0 0 0 34.95,40Z" />
    </group>
    <group android:name="sprocketL2" android:pivotX="34" android:pivotY="54">
        <path android:name="sL2" android:fillColor="@color/splash_background"
            android:pathData="M33.05,52A1.3,1.3 0 0 0 31.75,53.3V54.7A1.3,1.3 0 0 0 33.05,56H34.95A1.3,1.3 0 0 0 36.25,54.7V53.3A1.3,1.3 0 0 0 34.95,52Z" />
    </group>
    <group android:name="sprocketL3" android:pivotX="34" android:pivotY="66">
        <path android:name="sL3" android:fillColor="@color/splash_background"
            android:pathData="M33.05,64A1.3,1.3 0 0 0 31.75,65.3V66.7A1.3,1.3 0 0 0 33.05,68H34.95A1.3,1.3 0 0 0 36.25,66.7V65.3A1.3,1.3 0 0 0 34.95,64Z" />
    </group>
    <group android:name="sprocketR1" android:pivotX="74" android:pivotY="42">
        <path android:name="sR1" android:fillColor="@color/splash_background"
            android:pathData="M73.05,40A1.3,1.3 0 0 0 71.75,41.3V42.7A1.3,1.3 0 0 0 73.05,44H74.95A1.3,1.3 0 0 0 76.25,42.7V41.3A1.3,1.3 0 0 0 74.95,40Z" />
    </group>
    <group android:name="sprocketR2" android:pivotX="74" android:pivotY="54">
        <path android:name="sR2" android:fillColor="@color/splash_background"
            android:pathData="M73.05,52A1.3,1.3 0 0 0 71.75,53.3V54.7A1.3,1.3 0 0 0 73.05,56H74.95A1.3,1.3 0 0 0 76.25,54.7V53.3A1.3,1.3 0 0 0 74.95,52Z" />
    </group>
    <group android:name="sprocketR3" android:pivotX="74" android:pivotY="66">
        <path android:name="sR3" android:fillColor="@color/splash_background"
            android:pathData="M73.05,64A1.3,1.3 0 0 0 71.75,65.3V66.7A1.3,1.3 0 0 0 73.05,68H74.95A1.3,1.3 0 0 0 76.25,66.7V65.3A1.3,1.3 0 0 0 74.95,64Z" />
    </group>

    <!-- The play mark, last in and last out. -->
    <group android:name="play" android:pivotX="54" android:pivotY="54">
        <path
            android:name="playTriangle"
            android:fillColor="#FFB648"
            android:strokeColor="#FFB648"
            android:strokeWidth="3.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M49,46.5L49,61.5L62,54Z" />
    </group>
</vector>
