## This is an example local.properties template.
# Copy this file to local.properties and replace the placeholders with your actual TMDB credentials.
# Get your API keys at: https://www.themoviedb.org/settings/api

# Location of the Android SDK (automatically generated by Android Studio)
# sdk.dir=/Users/your_username/Library/Android/sdk

# TMDB credentials
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
